# URL base do backend Cred+ (sem barra no final).
# O app monta as chamadas como ${VITE_API_BASE_URL}/cred/...
# Em dev, o backend Spring Boot roda em http://localhost:8080 (context-path /cred).
# Copie este arquivo para .env.local e ajuste o valor conforme o seu ambiente.
VITE_API_BASE_URL=http://localhost:8080
