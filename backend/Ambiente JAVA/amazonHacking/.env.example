# Variáveis de ambiente do backend Cred+ (copie para .env e preencha com valores reais).
# NUNCA commite o .env com valores reais.

# Banco de dados PostgreSQL (NeonDB)
DB_HOST=host_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco

# Segredo usado para assinar os tokens JWT
JWT_SECRET=uma_chave_secreta_longa_e_aleatoria

# Caminho do arquivo de credenciais do Google Earth Engine
GEE_KEY_PATH=/caminho/para/chave-gee.json

# Armazenamento das fotos das safras (Cloudinary).
# Pegue os 3 valores no painel: https://console.cloudinary.com (Settings > API Keys + Product Environment).
# RECOMENDADO: 3 variáveis separadas (não depende do formato de URL).
CLOUDINARY_CLOUD_NAME=nome_do_cloud
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
# Alternativa: uma URL única (formato cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
